{
  "name": "nostalgic-startpage",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "description": "Windows XP desktop as your new tab page — modular TS rebuild",
  "scripts": {
    "build": "vite build && vite build --config vite.bg.config.ts",
    "watch": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
